{
  "name": "notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "Small notification service: Node.js, TypeScript, OpenAPI contract first",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
